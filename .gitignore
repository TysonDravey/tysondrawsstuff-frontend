# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# product images are served from Cloudinary, not committed to git
/public/products/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# TDS Railway tray (tools/tds_tray.py)
/tools/venv/
/tools/*.log
/tools/__pycache__/

# Full-size product images must never ship with the site (local-mode sync output only)
public/products/

# Etsy OAuth tokens (tools/etsy/etsy_sync.py)
/tools/etsy/.etsy-tokens.json
# describe tool (tools/describe/strapi_desc.py): photo cache and description backups
/tools/describe/.cache/
/tools/describe/backups/
